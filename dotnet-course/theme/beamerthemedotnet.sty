% dotnet -- the shared beamer theme for the .NET course (L01..L15).
%
%   \usetheme{dotnet}
%
% One file, every lecture. A deck sets its own title and frames; everything
% else -- language, fonts, palette, furniture, code styles -- comes from here,
% so lecture 12 looks like lecture 1 without anyone remembering to make it so.
%
% Design rules this theme exists to enforce (inherited from beamerthemepure,
% the Pure ecosystem talk, and kept deliberately identical in spirit):
%   * Every content slide has a title. If it cannot be titled, it is not a
%     slide -- it is a sentence from the script that escaped.
%   * A slide states a claim and then shows the evidence for it. No slogans,
%     no billboards, no rhetorical questions on their own page.
%   * One accent colour, used inline on the word that carries the claim:
%     \hi{...}. Roughly once per slide. It is not a highlighter.
%   * Nothing on a slide is bigger than it has to be. The lecture title is the
%     largest text in the deck; after that, a section title. Nothing else
%     competes with them.
%
% Engine: pdflatex. The course is in Russian, so this is T2A + babel, not
% fontspec -- see ../theme/README.md for why that decision went the way it did.
%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemedotnet}[2026/09/14 v1.0 .NET course theme]

% -------------------------------------------------------------- language --
% Loaded by the theme, not by the deck, so no lecture can drift. Shorthands
% are off on purpose: babel-russian makes " active, which breaks listings and
% verbatim. Typographic quotes are typed directly as UTF-8 -- <<like this>>.
\RequirePackage{cmap}            % before fontenc, or it cannot patch the fonts
\RequirePackage[utf8]{inputenc}
\RequirePackage[T1,T2A]{fontenc}
\RequirePackage[shorthands=off,english,russian]{babel}

\RequirePackage{xcolor}
\RequirePackage{listings}
\RequirePackage{tikz}
\RequirePackage{amssymb}
\RequirePackage{microtype}

% ------------------------------------------------------------------ type --
% PT Sans for everything, PT Mono for code: a humanist grotesque commissioned
% for Russian public typography, with a mono whose glyphs stay apart from the
% back row. It lives in TeX Live (`paratype`, Debian: texlive-fonts-extra) and
% on Overleaf; when it is not installed the deck falls back to Latin Modern
% rather than failing, so both paths are worth a look after an edit.
\newif\ifhaveparatype
\IfFileExists{paratype.sty}{\haveparatypetrue}{\haveparatypefalse}
\ifhaveparatype
  \RequirePackage{paratype}
\else
  \RequirePackage{lmodern}
\fi
\renewcommand{\familydefault}{\sfdefault}

% ---------------------------------------------------------------- palette --
% Tuned for a projector in a lit lecture hall, not for a laptop screen. The
% Pure deck's values were a step too light once they hit a wall: `muted` in
% particular disappeared. Everything here is darker than its Pure counterpart.
%
% TWO colours carry meaning, and only two:
%   accent (teal)  -- the primary: the word a claim turns on, the first side
%                     of a comparison, the thing you should do.
%   alt (brick)    -- the second side of a comparison, and the one caution
%                     line per deck. Never decorative.
% Held consistently, so the room learns the pairing instead of decoding it.
\definecolor{ink}{HTML}{14171A}
\definecolor{accent}{HTML}{0E5A72}
\definecolor{alt}{HTML}{9C3D14}
\definecolor{muted}{HTML}{3F464D}
\definecolor{hairline}{HTML}{B3AFA6}
\definecolor{paper}{HTML}{FBFAF7}
\definecolor{kw}{HTML}{1F3D57}
\definecolor{str}{HTML}{3A5B44}
\definecolor{codebg}{HTML}{EFEDE6}   % listing ground, one step off the paper
\colorlet{warn}{alt}                 % the caution tone is the second accent

% -------------------------------------------------------------- structure --
\setbeamercolor{normal text}{fg=ink,bg=paper}
\setbeamercolor{background canvas}{bg=paper}
\setbeamercolor{structure}{fg=accent}
\setbeamercolor{frametitle}{fg=ink}
\setbeamercolor{itemize item}{fg=muted}
\setbeamercolor{itemize subitem}{fg=muted}
\setbeamercolor{enumerate item}{fg=muted}
\setbeamerfont{frametitle}{size=\large,series=\bfseries}
\setbeamerfont{footline}{size=\scriptsize}
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{itemize items}[square]

\setbeamertemplate{frametitle}{%
  \vspace{1.1em}%
  {\usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}\insertframetitle\par}%
  \vspace{0.25em}%
  {\color{hairline}\rule{\textwidth}{0.6pt}}%
}

% The footer carries the section, so the audience always knows where it is.
% The lecture tag sits on the left of it; the speaker's contacts belong on the
% title and closing slides, nowhere else. The number is set against the total,
% and a hairline along the very bottom edge fills as the lecture runs --
% visible if you look for it, not otherwise.
\newcommand{\dotnetlecture}[1]{\def\@dnclecture{#1}}
\def\@dnclecture{}
\newlength{\dncprogress}
\setbeamertemplate{footline}{%
  \hbox to \paperwidth{%
    \hspace{1.6em}%
    {\usebeamerfont{footline}\color{hairline}\@dnclecture}%
    \hspace{0.9em}%
    {\usebeamerfont{footline}\color{muted}\insertsectionhead}%
    \hfill
    {\usebeamerfont{footline}\color{muted}\insertframenumber
     \,{\color{hairline}/\,\inserttotalframenumber}}%
    \hspace{1.6em}%
  }%
  \vspace{0.7em}%
  % Beamer only learns the total from the .nav file written by the previous
  % run, so on a first pass the frame number runs past it. Skip the bar then
  % rather than multiply \paperwidth into an arithmetic overflow.
  \ifnum\value{framenumber}>\inserttotalframenumber\else
    \setlength{\dncprogress}{\paperwidth}%
    \divide\dncprogress by \inserttotalframenumber
    \multiply\dncprogress by \value{framenumber}%
    \hbox to \paperwidth{%
      \rlap{\color{hairline}\rule{\paperwidth}{0.5pt}}%
      {\color{accent!35!paper}\rule{\dncprogress}{0.5pt}}\hfill}%
  \fi
}

% --------------------------------------------------------- vertical rhythm --
% Three gaps, and a text slide uses no others -- a literal \vspace on one is a
% bug. Code frames are the exception: the gaps around a listing are tuned per
% frame to make the snippet fit, and that is the only place a raw \vspace
% belongs.
\newcommand{\slidetop}{\vspace{0.8em}}   % title rule -> the body
\newcommand{\slidegap}{\vspace{1.4em}}   % between blocks of the body
\newcommand{\rulegap}{\vspace{1.0em}}    % after a thin rule, before what it
                                         % introduces

% --------------------------------------------------------------- elements --
% Inline accents. \hi is the primary (teal), \lo the second (brick). Use them
% freely -- a slide with no colour on it reads as flat from the back of the
% hall -- but never more than these two, and never decoratively.
\newcommand{\hi}[1]{\textcolor{accent}{#1}}
\newcommand{\lo}[1]{\textcolor{alt}{#1}}

% A coloured, letterspaced column head. The colour is the column's identity and
% is repeated on that column's bullets.
\newcommand{\colhead}[2]{%
  {\color{#1}\footnotesize\bfseries\textls[90]{\MakeUppercase{#2}}}}

% Bullet list whose markers take a colour: \begin{cbul}{accent} ... \end{cbul}
% Items sit on one baseline grid so two lists side by side line up.
\newenvironment{cbul}[1]{%
  \setbeamercolor{itemize item}{fg=#1}%
  \begin{itemize}\setlength{\itemsep}{0.5em}\setlength{\parskip}{0pt}%
}{\end{itemize}}

% The claim a slide makes, directly under its title: one size up from the body,
% never centred, never more than two lines. Carries its own trailing gap.
\newcommand{\claim}[1]{{\large #1\par}\vspace{1.1em}}

% Quiet supporting line: the evidence, the caveat, the aside.
\newcommand{\aside}[1]{{\color{muted}\small #1}}

% Ends the paragraph on both sides. Without that the block after it sets on
% the same line as the rule -- silently, with no warning.
\newcommand{\hrulethin}[1]{\par\noindent{\color{hairline}%
  \rule{#1\linewidth}{0.7pt}}\par}

% Small uppercase label above a column or a block. Plain words only -- it
% uppercases its argument. (Not called \tag: amsmath, which beamer loads,
% owns that name.)
\newcommand{\eyebrow}[1]{{\color{muted}\footnotesize\textls[90]{\MakeUppercase{#1}}}}

% Section divider: number, title, rule, and one factual line about what is
% coming. Used on a [plain] frame -- the deck has no dark slides.
\newcommand{\sectionopener}[3]{%
  \vfill
  \begin{minipage}{0.86\textwidth}
    {\color{muted}\Large #1\par}
    \vspace{0.4em}
    {\LARGE\bfseries #2\par}
    \vspace{0.8em}
    {\color{hairline}\rule{0.30\linewidth}{0.8pt}\par}
    \vspace{0.8em}
    {\color{muted} #3\par}
  \end{minipage}
  \vfill
}

% The lecture title slide. Same shape as a section divider, one size up.
\newcommand{\titlepagednc}[4]{%
  \vfill
  \vspace{1.0em}
  {\color{muted}\large #1\par}
  \vspace{0.5em}
  {\huge\bfseries #2\par}
  \vspace{0.9em}
  {\color{hairline}\rule{0.34\textwidth}{0.8pt}\par}
  \vspace{0.9em}
  {\large #3\par}
  \vspace{1.8em}
  {#4\par}
  \vfill
}

% Display phrases (a statement, a section's closing line, a question put to
% the room) must not hyphenate: they are the lines the room photographs, and
% <<ноль ма-гии>> across two lines is not the send-off anybody wants.
\newcommand{\dncnohyph}{\hyphenpenalty=10000\exhyphenpenalty=10000\raggedright}

% One word, centred, as large as the deck ever goes. Exactly one slide per
% deck may use it, and only when the word is the entire content.
\newcommand{\shout}[1]{%
  \vfill
  \begin{center}{\fontsize{44}{52}\selectfont\bfseries\color{accent}#1\par}\end{center}
  \vfill
}

% A phrase that is the point, alone on the slide, set large. Two per deck at
% most: this is the thing the room should still be able to quote in March.
% Not a slogan -- it only earns the page when the sentence *is* the content.
\newcommand{\statement}[1]{%
  \vfill
  \begin{minipage}{0.88\textwidth}
    {\LARGE\dncnohyph #1\par}
  \end{minipage}
  \vfill
}

% The one-line thought a section closes on. Quieter than \statement: it is a
% summary, not a headline.
\newcommand{\keyline}[1]{%
  \vfill
  \begin{minipage}{0.86\textwidth}
    {\color{hairline}\rule{0.16\linewidth}{0.8pt}\par}
    \vspace{0.9em}
    {\Large\dncnohyph #1\par}
  \end{minipage}
  \vfill
}

% A question put to the room for a show of hands. The script marks these
% [ВОПРОС В ЗАЛ]; they recur in every lecture, so they get a shape of their
% own -- the question, and nothing else, so nobody reads ahead to the answer.
\newcommand{\vote}[1]{%
  \vfill
  \begin{minipage}{0.86\textwidth}
    \eyebrow{вопрос в зал}\par
    \vspace{0.7em}
    {\LARGE\dncnohyph #1\par}
  \end{minipage}
  \vfill
}

% Two-column comparison, the deck's most common furniture: SDK against
% Runtime, Debug against Release, PackageReference against ProjectReference.
% \versus{left head}{left body}{right head}{right body}
\newcommand{\versus}[4]{%
  \begin{minipage}[t]{0.455\textwidth}
    \colhead{accent}{#1}\par\vspace{0.8em}#2
  \end{minipage}\hfill
  \begin{minipage}[t]{0.455\textwidth}
    \colhead{alt}{#3}\par\vspace{0.8em}#4
  \end{minipage}%
}

% ------------------------------------------------------------------- code --
% Listings are ASCII only. pdflatex + T2A will not set Cyrillic inside a
% listing without a literate table nobody wants to maintain, and every snippet
% in this course is a command, a csproj, a json file or C# -- all ASCII
% already. Russian belongs in the prose around the listing, not inside it.
\lstdefinestyle{dncbase}{%
  basicstyle=\ttfamily\footnotesize,
  keywordstyle=\color{kw},
  commentstyle=\color{muted}\itshape,
  stringstyle=\color{str},
  showstringspaces=false,
  columns=fullflexible,
  keepspaces=true,
  tabsize=4,
  breaklines=false,
  aboveskip=0.4em,
  belowskip=0.2em,
  xleftmargin=0.5em,
  % the listing sits on its own ground: no frame, no shadow, one step of tone
  backgroundcolor=\color{codebg},
  frame=single,
  framerule=0pt,
  rulecolor=\color{codebg},
  framesep=0pt,
  framexleftmargin=6pt,
  framexrightmargin=6pt,
  framextopmargin=5pt,
  framexbottommargin=5pt,
}

\lstdefinestyle{csharp}{style=dncbase,language=[Sharp]C,
  morekeywords={record,var,init,with,nint,file,required}}
\lstdefinestyle{xml}{style=dncbase,language=XML,
  keywordstyle=\color{kw},identifierstyle=\color{ink},
  markfirstintag=true,tagstyle=\color{kw}}
\lstdefinestyle{json}{style=dncbase,language=,string=[b]",
  stringstyle=\color{str}}
\lstdefinestyle{bash}{style=dncbase,language=bash,
  keywordstyle=\color{ink},
  morekeywords={dotnet},
  emph={build,run,publish,restore,test,new,add,tool,install,pack,clean},
  emphstyle=\color{kw}}
% IL and terminal output are quoted verbatim: no language, no highlighting,
% nothing singled out. The slide's own sentence says which line matters.
\lstdefinestyle{plain}{style=dncbase,language=}
\lstdefinestyle{term}{style=dncbase,language=,basicstyle=\ttfamily\scriptsize}

\lstset{style=dncbase}

\endinput
