% Pure -- a plain beamer theme for the Pure ecosystem talks.
%
%   \usetheme{pure}
%
% Design rules this theme exists to enforce:
%   * Every content slide has a title. If it cannot be titled, it is not a
%     slide -- it is a sentence from the script that escaped.
%   * A slide states a claim and then shows the evidence for it. No slogans,
%     no billboards, no rhetorical questions on their own page.
%   * One accent colour, used inline on the word that carries the claim:
%     \hi{...}. Roughly once per slide. It is not a highlighter.
%   * Nothing on a slide is bigger than it has to be. The talk title is the
%     largest text in the deck; after that, a chapter title. Nothing else
%     competes with them.
%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemepure}[2026/08/18 v2.1 Pure talk theme]

\RequirePackage{xcolor}
\RequirePackage{listings}
\RequirePackage{tikz}
\RequirePackage{amssymb}
\RequirePackage{microtype}

% ------------------------------------------------------------------ type --
% Fira Sans for everything, Fira Mono for code: a humanist grotesque drawn for
% screens, with a mono whose glyphs stay apart from the back row. It lives in
% TeX Live (`fira`, needs `fontaxes` + `mweights`) and on Overleaf; when it is
% not installed the deck falls back to Latin Modern rather than failing, so
% both paths are worth a look after an edit.
\newif\ifhavefira
\IfFileExists{FiraSans.sty}{%
  \IfFileExists{FiraMono.sty}{\havefiratrue}{\havefirafalse}}{\havefirafalse}
\ifhavefira
  \RequirePackage[sfdefault,lining]{FiraSans}
  \RequirePackage[scaled=0.92]{FiraMono}
\fi

% ---------------------------------------------------------------- palette --
% Low chroma on purpose. The accent is a dark brick that sits next to the ink
% rather than jumping off the wall.
\definecolor{ink}{HTML}{1F2328}
\definecolor{accent}{HTML}{7C3016}
\definecolor{muted}{HTML}{5F666E}
\definecolor{hairline}{HTML}{D2CFC8}
\definecolor{paper}{HTML}{FBFAF7}
\definecolor{kw}{HTML}{334E68}
\definecolor{str}{HTML}{4E6E58}
\definecolor{codebg}{HTML}{F4F2ED}   % listing ground, one step off the paper
\definecolor{codehl}{HTML}{F1EAE5}   % the one line the slide is about

% -------------------------------------------------------------- structure --
\setbeamercolor{normal text}{fg=ink,bg=paper}
\setbeamercolor{background canvas}{bg=paper}
\setbeamercolor{structure}{fg=accent}
\setbeamercolor{frametitle}{fg=ink}
\setbeamercolor{itemize item}{fg=muted}
\setbeamercolor{itemize subitem}{fg=muted}
\setbeamercolor{enumerate item}{fg=muted}
\setbeamerfont{frametitle}{size=\large,series=\bfseries}
\setbeamerfont{footline}{size=\scriptsize}
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{itemize items}[square]

\setbeamertemplate{frametitle}{%
  \vspace{1.1em}%
  {\usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}\insertframetitle\par}%
  \vspace{0.25em}%
  {\color{hairline}\rule{\textwidth}{0.6pt}}%
}

% The footer carries the chapter, so the audience always knows where it is.
% The speaker's handle belongs on the title and closing slides, nowhere else.
% The number is set against the total, and a hairline along the very bottom
% edge fills as the talk runs -- visible if you look for it, not otherwise.
\newlength{\pureprogress}
\setbeamertemplate{footline}{%
  \hbox to \paperwidth{%
    \hspace{1.6em}%
    {\usebeamerfont{footline}\color{muted}\insertsectionhead}%
    \hfill
    {\usebeamerfont{footline}\color{muted}\insertframenumber
     \,{\color{hairline}/\,\inserttotalframenumber}}%
    \hspace{1.6em}%
  }%
  \vspace{0.7em}%
  % Beamer only learns the total from the .nav file written by the previous
  % run, so on a first pass the frame number runs past it. Skip the bar then
  % rather than multiply \paperwidth into an arithmetic overflow.
  \ifnum\value{framenumber}>\inserttotalframenumber\else
    \setlength{\pureprogress}{\paperwidth}%
    \divide\pureprogress by \inserttotalframenumber
    \multiply\pureprogress by \value{framenumber}%
    \hbox to \paperwidth{%
      \rlap{\color{hairline}\rule{\paperwidth}{0.5pt}}%
      {\color{accent!35!paper}\rule{\pureprogress}{0.5pt}}\hfill}%
  \fi
}

% --------------------------------------------------------- vertical rhythm --
% Three gaps, and a text slide uses no others -- a literal \vspace on one is a
% bug. Code frames are the exception: the gaps around a listing are tuned per
% frame to make the snippet fit, and that is the only place a raw \vspace
% belongs.
\newcommand{\slidetop}{\vspace{0.8em}}   % title rule -> the body
\newcommand{\slidegap}{\vspace{1.4em}}   % between blocks of the body
\newcommand{\rulegap}{\vspace{1.0em}}    % after a thin rule, before what it
                                         % introduces

% --------------------------------------------------------------- elements --
% Inline accent. One per slide, on the word the claim turns on.
\newcommand{\hi}[1]{\textcolor{accent}{#1}}

% The claim a slide makes, directly under its title: one size up from the body,
% never centred, never more than two lines. Carries its own trailing gap.
\newcommand{\claim}[1]{{\large #1\par}\vspace{1.1em}}

% Quiet supporting line: the evidence, the caveat, the aside.
\newcommand{\aside}[1]{{\color{muted}\small #1}}

\newcommand{\hrulethin}[1]{{\color{hairline}\rule{#1\linewidth}{0.6pt}}}

% Small uppercase label above a column or a block. Plain words only -- it
% uppercases its argument. (Not called \tag: amsmath, which beamer loads,
% owns that name.)
\newcommand{\eyebrow}[1]{{\color{muted}\footnotesize\textls[90]{\MakeUppercase{#1}}}}

% The deck's mark: the three-node composition tree from the chapter-4 diagram,
% in hairlines. It is the talk's own picture, not decoration -- a root that is
% nothing but the two things under it. \puremark[2] scales it.
\newcommand{\puremark}[1][1]{%
  \begin{tikzpicture}[scale=#1,baseline=0pt]
    \draw[hairline] (0,0.5) -- (-0.42,0);
    \draw[hairline] (0,0.5) -- (0.42,0);
    \draw[hairline,fill=paper] (-0.42,0) circle (0.06);
    \draw[hairline,fill=paper] (0.42,0) circle (0.06);
    \fill[accent] (0,0.5) circle (0.06);
  \end{tikzpicture}%
}

% Chapter divider: number, title, rule, and one factual line about what is
% coming. Used on a [plain] frame -- the deck has no dark slides.
\newcommand{\chapterpage}[3]{%
  \vfill
  \begin{minipage}{0.86\textwidth}
    {\puremark[0.85]\par}
    \vspace{0.9em}
    {\color{muted}\Large #1\par}
    \vspace{0.4em}
    {\LARGE\bfseries #2\par}
    \vspace{0.8em}
    {\color{hairline}\rule{0.30\linewidth}{0.8pt}\par}
    \vspace{0.8em}
    {\color{muted} #3\par}
  \end{minipage}
  \vfill
}

% ------------------------------------------------------------------- code --
\lstdefinestyle{csharp}{%
  language=[Sharp]C,
  basicstyle=\ttfamily\footnotesize,
  keywordstyle=\color{kw},
  commentstyle=\color{muted}\itshape,
  stringstyle=\color{str},
  morekeywords={record,params,var,init,with},
  emph={IString,INumber,IBool,IDate,IChar,IDeterminedHash,IDayOfWeek,ITime},
  emphstyle=\color{accent},
  showstringspaces=false,
  columns=fullflexible,
  keepspaces=true,
  tabsize=4,
  breaklines=false,
  aboveskip=0.4em,
  belowskip=0.2em,
  xleftmargin=0.5em,
  % the listing sits on its own ground: no frame, no shadow, one step of tone.
  % The padding is framex*margin, not framesep, so a listing can be cut into
  % pieces that still join seamlessly (see csharphl below).
  backgroundcolor=\color{codebg},
  frame=single,
  framerule=0pt,
  rulecolor=\color{codebg},
  framesep=0pt,
  framexleftmargin=6pt,
  framexrightmargin=6pt,
  framextopmargin=5pt,
  framexbottommargin=5pt,
}
\lstset{style=csharp}

% One snippet, three listings: the middle one -- the lines the slide is about --
% sits on a warmer ground. Skips and inner margins are zero at every cut, so
% the three pieces read as one block. Order: csharptop, csharphl, csharpbot;
% drop the first or the last when the highlight starts or ends the snippet.
\lstdefinestyle{csharptop}{style=csharp,belowskip=0pt,framexbottommargin=0pt}
\lstdefinestyle{csharphl}{style=csharp,aboveskip=0pt,belowskip=0pt,
  framextopmargin=0pt,framexbottommargin=0pt,
  backgroundcolor=\color{codehl},rulecolor=\color{codehl}}
\lstdefinestyle{csharpbot}{style=csharp,aboveskip=0pt,framextopmargin=0pt}

\endinput
